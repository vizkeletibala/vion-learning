# Vion Learning private deployment example
# Copy to .env on the deployment host and fill secrets there. Never commit .env.

# App container: loopback-only bind used by docker-compose.yml.
VION_APP_HOST_PORT=9140
NODE_ENV=production
PORT=3000

# RAG admin HTTP routes are disabled by default. If you enable them for private
# operator smoke checks, keep them behind Tailnet-only access and set a token.
VION_RAG_API_ENABLED=0
VION_RAG_ADMIN_TOKEN=

# pgvector container profile. These are required only when running:
#   docker compose --profile rag up -d
VION_RAG_PGHOST=127.0.0.1
VION_RAG_PGPORT=55432
VION_RAG_PGDATABASE=vion_rag
POSTGRES_DB=vion_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-admin-password
VION_RAG_APP_PASSWORD=replace-with-random-app-password
VION_RAG_READONLY_PASSWORD=replace-with-random-readonly-password
VION_RAG_MIGRATOR_PASSWORD=replace-with-random-migrator-password

# Host-side runtime connection strings. Prefer the app role for live embedding
# writes and the admin/migrator role only for applying db/migrations/*.sql.
VION_RAG_DATABASE_URL=postgresql://vion_rag_app:replace-with-random-app-password@127.0.0.1:55432/vion_rag
VION_RAG_MIGRATOR_DATABASE_URL=postgresql://vion_rag_migrator:replace-with-random-migrator-password@127.0.0.1:55432/vion_rag

# Live embeddings are opt-in; dry-run RAG commands do not need this.
OPENAI_API_KEY=
